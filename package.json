{
  "name": "@forest",
  "private": true,
  "workspaces": [
    "apps/*",
    "test-e2e"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '*' dev",
    "knip": "knip",
    "lint:gherkin": "gherkin-lint -c .claude/skills/specification/lint/gherkin-lintrc.json",
    "lint:story": "markdownlint-cli2 --config .claude/skills/specification/lint/.markdownlint-cli2.jsonc",
    "test:e2e": "bun run --cwd test-e2e test",
    "test:scripts": "bun test ./.github/scripts"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "gherkin-lint": "4.2.4",
    "knip": "6.38.0",
    "markdownlint-cli2": "0.23.3",
    "typescript": "7.0.2"
  }
}
