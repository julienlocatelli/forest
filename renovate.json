{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Forest dependency updates. Renovate opens pull requests only; the update-check skill verifies and merges them.",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":semanticCommitScope(deps)"
  ],
  "enabledManagers": ["bun", "mise", "github-actions"],
  "rangeStrategy": "pin",
  "automerge": false,
  "platformAutomerge": false,
  "draftPR": false,
  "dependencyDashboard": true,
  "packageRules": [
    {
      "description": "Prisma's CLI, client and adapters must move to one version together.",
      "groupName": "prisma",
      "matchPackageNames": ["prisma", "@prisma/**"]
    }
  ]
}
