PORT=3001
# Default branch of the Forest Neon project (see README). Percent-encode passwords.
# Remove query parameters; TLS is configured with certificate verification.
# Pooled host (-pooler) for the runtime, direct host for migrations; same endpoint ID.
DATABASE_URL=postgresql://forest_app:PASSWORD@ep-ENDPOINT-pooler.REGION.aws.neon.tech/neondb
MIGRATION_DATABASE_URL=postgresql://forest_migration:PASSWORD@ep-ENDPOINT.REGION.aws.neon.tech/neondb
# Neon uses a public CA: leave unset to verify against the system roots.
# DATABASE_SSL_CA_PATH=
DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_QUERY_TIMEOUT_MS=15000
# Child branch `test` of the same project, never the application or production branch.
# Its own endpoint ID; same pooled/direct split as above.
TEST_DATABASE_URL=postgresql://forest_app:PASSWORD@ep-TEST-ENDPOINT-pooler.REGION.aws.neon.tech/neondb
TEST_MIGRATION_DATABASE_URL=postgresql://forest_migration:PASSWORD@ep-TEST-ENDPOINT.REGION.aws.neon.tech/neondb
# The tests never use DATABASE_SSL_CA_PATH; leave unset for the system roots.
# TEST_DATABASE_SSL_CA_PATH=
TEST_DATABASE_CONFIRM_ISOLATED=false
# Production Neon endpoint ID (ep-...), or none if no production exists.
PRODUCTION_DATABASE_PROJECT_REF=none

# Mandatory local identity bootstrap. Supply a private password of 12–128 characters.
# Existing identity is never reset; changing email may create another ordinary user.
DEFAULT_USER_EMAIL=local-user@example.com
DEFAULT_USER_PASSWORD=
# Exact comma-separated origins. HTTPS required except http://localhost.
AUTH_ALLOWED_ORIGINS=http://localhost:3000
