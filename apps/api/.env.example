PORT=3001
# Copy connection strings from Supabase Connect. Percent-encode passwords.
# Remove query parameters; TLS is configured with certificate verification.
DATABASE_URL=postgresql://forest_app.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
MIGRATION_DATABASE_URL=postgresql://forest_migration.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
DATABASE_SSL_CA_PATH=${PWD}/../../infra/cert/prod-supabase.crt
DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_QUERY_TIMEOUT_MS=15000
# Separate dedicated test project, never the runtime/production project.
TEST_DATABASE_URL=postgresql://forest_app.TEST_PROJECT_REF:PASSWORD@TEST_POOLER_HOST:5432/postgres
TEST_MIGRATION_DATABASE_URL=postgresql://forest_migration.TEST_PROJECT_REF:PASSWORD@TEST_POOLER_HOST:5432/postgres
TEST_DATABASE_CONFIRM_ISOLATED=false
# Actual production ref, or none if no production project exists.
PRODUCTION_DATABASE_PROJECT_REF=none

# A third disposable, unprepared project for the conflict test.
TEST_CONFLICT_MIGRATION_DATABASE_URL=postgresql://forest_migration.CONFLICT_PROJECT_REF:PASSWORD@CONFLICT_POOLER_HOST:5432/postgres
