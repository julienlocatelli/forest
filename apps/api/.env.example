PORT=3001
# Copy connection strings from Supabase Connect. Percent-encode passwords.
# Remove query parameters; TLS is configured with certificate verification.
DATABASE_URL=postgresql://forest_app.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
MIGRATION_DATABASE_URL=postgresql://forest_migration.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
DATABASE_SSL_CA_PATH=${PWD}/../../infra/certs/prod-supabase.crt
DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_QUERY_TIMEOUT_MS=15000
# Dedicated Neon test project, never the application or production project (see README).
# Pooled host (-pooler) for the runtime, direct host for migrations; same endpoint ID.
TEST_DATABASE_URL=postgresql://forest_app:PASSWORD@ep-ENDPOINT-pooler.REGION.aws.neon.tech/neondb
TEST_MIGRATION_DATABASE_URL=postgresql://forest_migration:PASSWORD@ep-ENDPOINT.REGION.aws.neon.tech/neondb
# Neon uses a public CA: leave unset to verify against the system roots.
# The tests never use DATABASE_SSL_CA_PATH.
# TEST_DATABASE_SSL_CA_PATH=
TEST_DATABASE_CONFIRM_ISOLATED=false
# Production Supabase project ref or Neon endpoint ID (ep-...), or none if no production exists.
PRODUCTION_DATABASE_PROJECT_REF=none

# native by default; docker for macOS TLS incompatibility with the Supabase pooler.
MIGRATION_CLI_MODE=native

# Mandatory local identity bootstrap. Supply a private password of 12–128 characters.
# Existing identity is never reset; changing email may create another ordinary user.
DEFAULT_USER_EMAIL=local-user@example.com
DEFAULT_USER_PASSWORD=
# Exact comma-separated origins. HTTPS required except http://localhost.
AUTH_ALLOWED_ORIGINS=http://localhost:3000
