generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}
datasource db {
  provider = "postgresql"
}
model User {
  id Int @id @default(autoincrement())
  firstName String @db.VarChar
  lastName String @db.VarChar
  isActive Boolean @default(true)
  @@map("user")
}
