{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": [
    "-lintignore"
  ],
  "workspaces": {
    ".": {
      "entry": [
        ".github/scripts/*.ts"
      ]
    },
    "apps/api": {
      "entry": [
        "src/main.ts",
        "src/database/migrate.ts",
        "src/**/*.spec.ts",
        "test/**/*.e2e-spec.ts",
        "test/database-setup.ts",
        "vitest.config*.ts",
        "test/**/*.spec.ts"
      ],
      "vitest": false,
      "ignoreDependencies": [
        "@prisma/client",
        "@nestjs/mau"
      ]
    },
    "test-e2e": {
      "entry": [
        "cucumber.mjs",
        "support/**/*.ts",
        "steps/**/*.ts"
      ],
      "cucumber": false
    }
  },
  "ignore": [
    ".claude/**"
  ]
}
